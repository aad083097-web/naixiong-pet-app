{
  "schemaVersion": 5,
  "app": {
    "name": "奶凶小猫",
    "appId": "com.doubao.naixiong.pet",
    "version": "1.0.0",
    "language": "zh-CN"
  },
  "targets": {
    "windows": {
      "enabled": true,
      "arch": "x64"
    },
    "macos": {
      "enabled": true,
      "arch": "current"
    }
  },
  "character": {
    "inputType": "single-image",
    "coreAsset": "core-ip.png",
    "displayName": "奶凶",
    "archetype": "cat",
    "personality": [
      "傲娇",
      "嘴硬心软",
      "贪吃"
    ],
    "preserveTraits": [
      "白色圆润身体",
      "黑色粗轮廓",
      "大圆眼黑瞳淡黄眼白",
      "粉色脸颊晕染",
      "弯弯小嘴弧线",
      "呆萌中带小凶的傲娇表情"
    ],
    "style": "preserve",
    "mirrorSafe": true
  },
  "assetPipeline": {
    "backgroundMode": "semantic-cutout",
    "segmentationBackend": "auto",
    "subjectKind": "illustration",
    "generationBackground": "transparent-grid",
    "backgroundTolerance": 24,
    "edgeFeather": 8,
    "safeMargin": 32,
    "targetOccupancy": 0.76
  },
  "experience": {
    "theme": {
      "primary": "#FFF3EE",
      "accent": "#FF8FA3",
      "background": "#FFF9F5",
      "surface": "#FFFFFF",
      "text": "#4A3434",
      "muted": "#B49A96",
      "cornerRadius": 20
    },
    "petSizing": {
      "baseWindowPx": 220,
      "defaultScale": 0.8
    },
    "interactions": [
      {
        "id": "pet-head",
        "emoji": "🐾",
        "label": "摸摸头",
        "stateId": "pet-head",
        "durationMs": 2400,
        "affectionGain": 5,
        "feedback": [
          "哼……才、才不是稀罕呢",
          "喵呜……就这一次哦",
          "你的手好暖，勉强喜欢一下",
          "再摸的话……也不是不可以"
        ]
      },
      {
        "id": "feed-fish",
        "emoji": "🐟",
        "label": "喂小鱼干",
        "stateId": "feed-fish",
        "durationMs": 3000,
        "affectionGain": 8,
        "feedback": [
          "小鱼干！算你识相",
          "咔嚓咔嚓……还有吗？",
          "本喵批准你投喂",
          "吃饱了才有力气傲娇"
        ]
      },
      {
        "id": "play-teaser",
        "emoji": "🪶",
        "label": "逗猫棒",
        "stateId": "play-teaser",
        "durationMs": 3000,
        "affectionGain": 6,
        "feedback": [
          "看招！喵！",
          "才、才不是想玩呢",
          "羽毛飞了！快捡回来",
          "本喵只是测试你的反应"
        ]
      }
    ]
  },
  "motion": {
    "breathing": {
      "enabled": true,
      "periodMs": 3200,
      "scaleX": 0.015,
      "scaleY": 0.025
    },
    "squashStretch": {
      "enabled": true,
      "durationMs": 260,
      "intensity": 0.08
    },
    "idleIntervalMs": {
      "min": 5000,
      "max": 12000
    }
  },
  "features": {
    "transparentWindow": true,
    "drag": true,
    "tray": true,
    "edgeSnap": true,
    "reminders": true,
    "interactions": true,
    "relationship": true,
    "filePocket": false,
    "dashboard": true,
    "typingReaction": false,
    "autonomousMovement": false
  },
  "states": [
